# Kernel config fragment for MoodNAS on the WD My Cloud EX4, applied on top
# of mainline multi_v5_defconfig. STATUS: draft (phase 5).

CONFIG_MACH_KIRKWOOD=y
CONFIG_ARCH_MULTI_V5=y

# Storage
CONFIG_SATA_MV=y
CONFIG_SATA_AHCI=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y
CONFIG_MD_LINEAR=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_VFAT_FS=m

# Hardware
CONFIG_MTD_NAND_ORION=y
CONFIG_MTD_UBI=y
CONFIG_I2C_MV64XXX=y
CONFIG_I2C_CHARDEV=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_KIRKWOOD_THERMAL=y
CONFIG_ORION_WATCHDOG=y
CONFIG_CRYPTO_DEV_MARVELL_CESA=y
CONFIG_MV_XOR=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_ORION=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_LEDS_GPIO=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_MV643XX_ETH=y
CONFIG_MARVELL_PHY=y

# Ransomware sentinel and services
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_WIREGUARD=m
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y

# Hardening
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_SECCOMP=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# kexec so a future MoodNAS can chain-load newer kernels without touching NAND
CONFIG_KEXEC=y
